# ---- Server-side only (Vercel → Project → Settings → Environment Variables) ----
# NEVER prefix these with VITE_ and never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random string; used to hash visitor IPs for rate limiting
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
# Comma-separated exact origins allowed to call /api/enquiry
ALLOWED_ORIGINS=https://tushalsisodia-dev.vercel.app

# ---- Public build-time values (safe to expose) ----
# Supabase Project Settings → API → Project URL and anon/public key.
# These are intentionally public; RLS is the security boundary.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional contact details shown on the site; leave empty to hide
VITE_CONTACT_EMAIL=
VITE_WHATSAPP=
